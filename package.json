{
  "name": "guruguru-avatar",
  "private": true,
  "version": "1.9.1",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "relay": "node server/relay.mjs",
    "build": "vite build",
    "prebuild:local": "node scripts/copy-mediapipe-assets.mjs",
    "build:local": "cross-env VITE_BASE=/ vite build --outDir dist-local",
    "start": "node server/relay.mjs --web-root dist-local",
    "electron:dev": "npm run build:local && electron .",
    "dist:win": "npm run build:local && electron-builder --win",
    "dist:win:nsis": "npm run build:local && electron-builder --win nsis",
    "dist:win:portable": "npm run build:local && electron-builder --win portable",
    "build:relay": "npm run build:relay:win && npm run build:relay:linux && npm run build:relay:macos",
    "build:relay:win": "bun build --compile --minify --target=bun-windows-x64 server/relay.mjs --outfile dist-exe/guruguru-relay.exe",
    "build:relay:linux": "bun build --compile --minify --target=bun-linux-x64 server/relay.mjs --outfile dist-exe/guruguru-relay-linux-x64",
    "build:relay:macos": "bun build --compile --minify --target=bun-darwin-arm64 server/relay.mjs --outfile dist-exe/guruguru-relay-macos-arm64",
    "preview": "vite preview --base /guruguru-avatar/",
    "verify:pages": "node scripts/verify-pages-build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "setup:mediapipe": "node scripts/copy-mediapipe-assets.mjs",
    "predev": "node scripts/copy-mediapipe-assets.mjs",
    "prebuild": "node scripts/copy-mediapipe-assets.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@erase2d/fabric": "^1.2.1",
    "@mediapipe/tasks-vision": "^0.10.35",
    "fabric": "^7.4.0",
    "pixi.js": "^8.19.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.2",
    "cross-env": "^7.0.3",
    "electron": "^42.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8",
    "workbox-window": "^7.4.1"
  },
  "build": {
    "appId": "com.tommie.guruguru-avatar",
    "productName": "Guruguru Avatar",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "electron/main.mjs",
      "electron/embedded-server.mjs",
      "electron/tailscale.mjs",
      "server/static.mjs",
      "server/relay-core.mjs",
      "src/relay-mode.js",
      "package.json",
      "!**/*.test.mjs",
      "!node_modules/pixi.js/**",
      "!node_modules/@mediapipe/**",
      "!node_modules/fabric/**",
      "!node_modules/@erase2d/**",
      "!node_modules/canvas/**",
      "!node_modules/react/**",
      "!node_modules/react-dom/**",
      "!node_modules/qrcode.react/**"
    ],
    "extraResources": [
      {
        "from": "dist-local",
        "to": "dist-local",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  }
}
